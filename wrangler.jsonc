{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supremacy-live",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // "/" resolves to different content depending on hostname (editor.html on
    // editor.supremacy.live, index.html elsewhere) — that decision has to run
    // in worker.js. Without this, Workers Assets serves "/" -> index.html
    // directly for every hostname without ever invoking the Worker, since a
    // static file matching the request path is served ahead of the Worker
    // script by default. Scoped to "/" only so every other static asset
    // (map.js, board-render.js, editor.html itself, ...) still serves
    // directly with no Worker invocation.
    "run_worker_first": ["/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "supremacy-live",
      "database_id": "556ba857-3eb5-4caa-91bc-b8b2efac7d91"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MATCH", "class_name": "Match" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Match", "Matchmaker"] }
  ],
  "routes": [
    { "pattern": "supremacy.live", "zone_name": "supremacy.live", "custom_domain": true },
    { "pattern": "www.supremacy.live", "zone_name": "supremacy.live", "custom_domain": true },
    { "pattern": "editor.supremacy.live", "zone_name": "supremacy.live", "custom_domain": true },
    { "pattern": "render.supremacy.live", "zone_name": "supremacy.live", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
