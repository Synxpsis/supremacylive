{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supremacy-live",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "supremacy-live",
      "database_id": "556ba857-3eb5-4caa-91bc-b8b2efac7d91"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MATCH", "class_name": "Match" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Match", "Matchmaker"] }
  ],
  "routes": [
    { "pattern": "supremacy.live", "zone_name": "supremacy.live", "custom_domain": true },
    { "pattern": "www.supremacy.live", "zone_name": "supremacy.live", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
